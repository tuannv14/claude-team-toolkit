# Example: ~/.linear/credentials   (chmod 600, never commit)
# Copy this template to ~/.linear/credentials and fill with your real key.
# Add as many [profile] sections as you need (one per Linear workspace).

# Recommended: a Read-only key for everyday queries...
[default]
api_key      = lin_api_your-read-only-key-here
default_team = ENG
read_only    = true

# ...and a separate, narrower key for the rare write, gated by a prompt.
[work]
api_key         = lin_api_your-write-key-here
default_team    = PLAT
require_confirm = true

[client_a]
api_key         = lin_api_your-client-workspace-key-here
default_team    = APP
read_only       = true

# default_team is the team KEY (the ENG in ENG-123), not a UUID.
#
# Create a key at: Linear -> Settings -> Account -> Security & Access
#                  -> Personal API keys -> Create API key
#                  https://linear.app/settings/account/security
#
# PERMISSIONS: a key is created with explicit permissions, so pick the least
# privilege that covers what you use:
#   Read                       -> me, teams, states, issues, issue, search,
#                                 projects, cycles
#   Read + Create issues       -> also /linear create
#   Read + Create comments     -> also /linear comment
#   Read + Write               -> also /linear update, /linear archive
#   Admin                      -> never needed by this skill
#
# You can also restrict the key to specific teams when you create it. Do that.
# It is the only limit that still holds if the key leaks.
#
# The key is shown ONCE at creation — copy it then. Keys never expire; they
# stay valid until you revoke them on that same settings page.
#
# read_only = true makes this skill refuse every write verb on the profile,
# even if the key itself carries Write. Defense in depth.
#
# Switch profile: /linear --profile work issues   (or set LINEAR_PROFILE=work)
