{
  "//": "Permission tiers for the azure-devops, heroku and linear MCP servers.",
  "//  ": "Merge the permissions block into YOUR project's .claude/settings.json.",
  "//   ": "Reads allow, state-changing denies. An unlisted tool is not denied - it",
  "//    ": "prompts. Denying is a decision; leaving a tool out is not.",
  "//     ": "Tool names come from the servers described in docs/mcp-servers.md. An",
  "//      ": "on-prem Azure DevOps server's names will differ from the cloud one's:",
  "//       ": "check yours with /mcp before copying this wholesale.",

  "permissions": {
    "allow": [
      "mcp__azure-devops__whoami",
      "mcp__azure-devops__list-projects",
      "mcp__azure-devops__list-repos",
      "mcp__azure-devops__list-branches",
      "mcp__azure-devops__list-pull-requests",
      "mcp__azure-devops__get-pr-changes",
      "mcp__azure-devops__list-teams",
      "mcp__azure-devops__list-users",
      "mcp__azure-devops__list-bugs",
      "mcp__azure-devops__list-defects",
      "mcp__azure-devops__list-epics",
      "mcp__azure-devops__list-features",
      "mcp__azure-devops__list-impediments",
      "mcp__azure-devops__list-product-backlog-items",
      "mcp__azure-devops__list-tasks",
      "mcp__azure-devops__list-test-cases",
      "mcp__azure-devops__get-workitem-detail",
      "mcp__azure-devops__search-workitems",
      "mcp__azure-devops__list-wikis",
      "mcp__azure-devops__list-wiki-pages",
      "mcp__azure-devops__get-wiki-page-content",

      "mcp__heroku__list_apps",
      "mcp__heroku__get_app_info",
      "mcp__heroku__get_app_logs",
      "mcp__heroku__list_teams",
      "mcp__heroku__list_private_spaces",
      "mcp__heroku__list_addons",
      "mcp__heroku__get_addon_info",
      "mcp__heroku__list_addon_services",
      "mcp__heroku__list_addon_plans",
      "mcp__heroku__ps_list",
      "mcp__heroku__pg_info",
      "mcp__heroku__pg_ps",
      "mcp__heroku__pg_locks",
      "mcp__heroku__pg_outliers",
      "mcp__heroku__pg_backups",
      "mcp__heroku__pg_maintenance",
      "mcp__heroku__pipelines_list",
      "mcp__heroku__pipelines_info",

      "mcp__linear__list_issues",
      "mcp__linear__get_issue",
      "mcp__linear__list_comments",
      "mcp__linear__list_teams",
      "mcp__linear__list_users",
      "mcp__linear__list_issue_statuses",
      "mcp__linear__list_issue_labels",
      "mcp__linear__list_projects",
      "mcp__linear__get_project",
      "mcp__linear__list_cycles",
      "mcp__linear__list_documents",
      "mcp__linear__get_document",
      "mcp__linear__list_milestones",
      "mcp__linear__search_documentation"
    ],

    "deny": [
      "mcp__heroku__create_app",
      "mcp__heroku__rename_app",
      "mcp__heroku__maintenance_on",
      "mcp__heroku__maintenance_off",
      "mcp__heroku__create_addon",
      "mcp__heroku__ps_scale",
      "mcp__heroku__ps_restart",
      "mcp__heroku__deploy_to_heroku",
      "mcp__heroku__deploy_one_off_dyno",
      "mcp__heroku__pipelines_create",
      "mcp__heroku__pipelines_promote",
      "mcp__heroku__pg_psql",
      "mcp__heroku__pg_credentials",
      "mcp__heroku__pg_kill",
      "mcp__heroku__pg_upgrade",

      "mcp__linear__delete_comment",
      "mcp__linear__delete_attachment",
      "mcp__linear__delete_diff_comment",
      "mcp__linear__delete_status_update",
      "mcp__linear__retire_issue_label",
      "mcp__linear__retire_project_label",
      "mcp__linear__merge_diff",
      "mcp__linear__submit_diff_review"
    ]
  },

  "// pg_credentials": "changes nothing, so it reads like a read tool. It prints live database credentials. Deny it.",
  "// pg_psql": "is an interactive shell against the database. Use the postgres skill with read_only = true instead.",
  "// linear writes": "save_issue, save_comment and the rest are left unlisted on purpose, so they prompt rather than being silently allowed or hard-denied. Move them to allow or deny once the team decides."
}
